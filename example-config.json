{
  "mcpServers": {
    "workspace": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/mcp-workspace-server/dist/index.js"],
      "env": {
        "MCP_WORKSPACE_ROOT": "/path/to/your/project",
        "MCP_ALLOWED_COMMANDS": "npm,git,node",
        "MCP_LOG_LEVEL": "info"
      }
    }
  }
}
